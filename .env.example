# Copy this file to .env and fill in real values. Never commit .env.

# --- Twilio (WhatsApp + SMS) ---
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN are shared across both channels —
# one Twilio account, no separate credentials needed for SMS vs WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_NUMBER=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# Secret + publishable keys: Stripe Dashboard -> Developers -> API keys.
# Webhook secret: shown when you register the endpoint at Developers -> Webhooks
# (Stripe CLI shows a different one for local forwarding — use the one for
# whichever listener is actually live: CLI for local dev, dashboard for prod).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Internal admin API (protects POST /bookings/{id}/complete) ---
ADMIN_API_KEY=

# --- App ---
PORT=8000
# Public URL this server is reachable at, no trailing slash — used to build
# tracking links sent to customers. Your ngrok URL for local dev, or your
# permanent host (Railway etc.) once deployed there.
PUBLIC_BASE_URL=http://localhost:8000

# E.164 phone number to notify as soon as a booking is confirmed, for any
# equipment row that has no owner_phone of its own set. Optional — with this
# unset, a booking for equipment with no owner_phone just skips the owner
# notification (logged, not an error).
DEFAULT_OWNER_PHONE=
